{
  "name": "encore-concert-lab",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node web/server.mjs",
    "test": "node --test e2e/api.test.mjs",
    "test:ui": "playwright test",
    "test:all": "npm run lab:normal && npm run test:references && npm run test:report",
    "test:report": "node scripts/report.mjs",
    "test:references": "node scripts/verify-references.mjs",
    "lab:normal": "node scripts/run-lab.mjs normal",
    "lab:bug": "node scripts/run-lab.mjs bug",
    "lab:report": "node scripts/lab-report.mjs",
    "lab:all": "npm run lab:normal && npm run lab:bug && npm run lab:report && node scripts/oracle-probe.mjs && node scripts/check-lab-mode.mjs && node scripts/bughunt-summary.mjs && npm run test:references && npm run test:report",
    "lab:validate": "node scripts/validate-homework.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
